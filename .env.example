# Variáveis de ambiente — copie para .env e ajuste

# Chave secreta JWT (troque em produção)
SECRET_KEY=dev-secret-change-me

# Origins permitidos no CORS (separados por vírgula)
CORS_ORIGINS=http://localhost:3000

# DATABASE_URL é definida automaticamente pelo docker-compose
# para override local:
# DATABASE_URL=postgresql+psycopg://agenda:agenda@localhost:5432/agenda_facil
